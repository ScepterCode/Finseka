# FinSeka environment settings
# Copy this file to .env and fill in the values from your Supabase project:
#   Supabase dashboard -> Project Settings -> API Keys  (and Data API for the URL)
# Never commit .env — it is ignored by git.

# --- Project ---------------------------------------------------------------
# The ID in your project URL: https://<project-id>.supabase.co
SUPABASE_PROJECT_ID="abcdefghijklmnopqrst"
SUPABASE_URL="https://abcdefghijklmnopqrst.supabase.co"

# Publishable key (safe to use in the browser; starts with sb_publishable_).
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Browser copies ---------------------------------------------------------
# Vite only exposes variables starting with VITE_ to the browser. Same values as above.
VITE_SUPABASE_PROJECT_ID="abcdefghijklmnopqrst"
VITE_SUPABASE_URL="https://abcdefghijklmnopqrst.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Server only: SECRET ----------------------------------------------------
# Secret key (starts with sb_secret_) or the legacy service_role key.
# Used only by server functions (inviting and removing team members, password change).
# It bypasses all security rules: never put it in a VITE_ variable or share it.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Optional: error monitoring ----------------------------------------------
# Sentry project DSN (Sentry -> Project settings -> Client keys). Leave empty to switch
# monitoring off. It is safe for the browser; errors are sent without personal data.
VITE_SENTRY_DSN=""

# --- Billing ----------------------------------------------------------------
# FinSeka Pro is ₦5,000 a month after a 30-day free trial. Online payment uses Bachs when
# BACHS_SECRET_KEY is set (pay for 1 to 12 months at once, no automatic renewal), otherwise
# Flutterwave when its first two values are set. With neither, organizations are shown the bank
# transfer details below instead.
#
# Bachs → Developer Portal → API keys. sk_sandbox_... to test without real money, sk_live_... for
# real payments. Server only: never VITE_.
BACHS_SECRET_KEY=""
# Bachs → Developer Portal → Webhooks: add https://<your site>/api/bachs-webhook with the events
# checkout.completed and collection.succeeded, and copy that endpoint's signing secret (whsec_...).
BACHS_WEBHOOK_SECRET=""
# Optional. Worked out from the key when empty: sk_live_ → https://api.bachs.io, otherwise
# https://sandbox-api.bachs.io
BACHS_API_URL=""
#
# Flutterwave → Settings → API keys. Use the TEST secret key (FLWSECK_TEST-...) to try payments
# with Flutterwave's test cards; switch to the LIVE key when ready. Server only: never VITE_.
FLUTTERWAVE_SECRET_KEY=""
# Flutterwave → Payments → Payment plans: create a ₦5,000 monthly plan and copy its ID.
FLUTTERWAVE_PLAN_ID=""
# Any long random text. Paste the same text in Flutterwave → Settings → Webhooks → Secret hash,
# and set the webhook URL there to https://<your site>/api/flutterwave-webhook
FLUTTERWAVE_WEBHOOK_HASH=""
# Your site's address, used to bring payers back after paying (e.g. https://finseka.app).
# Optional: without it, the address the request came from is used.
APP_URL=""
# Shown to organizations as the way to pay by bank transfer. Line breaks are kept.
# Example: "GTBank · FinSeka Ltd · 0123456789"
BILLING_BANK_DETAILS=""
